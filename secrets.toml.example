# Copy this file to secrets.toml (same folder) and fill in your real key(s).
# secrets.toml is where YOUR actual keys go — never commit that file to
# a public GitHub repo. If deploying to Streamlit Community Cloud, don't
# use a file at all — paste the keys into the app's "Secrets" panel in the
# dashboard instead (Settings -> Secrets), using the same key names below.

CPCB_API_KEY = "your-data-gov-in-api-key-here"

# Optional but recommended: free token from https://aqicn.org/data-platform/register
# Used as an automatic fallback (same underlying CPCB station data, served
# through a faster/more reliable pipe) if data.gov.in is slow or returns
# an error. The app works fine without this — it just falls back straight
# to simulated data instead of trying WAQI first.
WAQI_API_TOKEN = "your-waqi-token-here"
